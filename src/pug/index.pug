doctype html
html(lang='es')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
    meta(name='description', content='Relive - Servicio técnico y catálogo de accesorios')
    meta(name='author', content='Relive')
    title Relive - Catálogo de Accesorios
    link(rel='icon', type='image/svg+xml', href='assets/placeholder.svg')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='css/styles.css', rel='stylesheet')
  body
    nav.navbar.navbar-expand-lg.navbar-light.bg-light.sticky-top
      .container.px-4.px-lg-5
        a.navbar-brand.fw-bold(href='index.html') RELIVE
        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Abrir menú')
          span.navbar-toggler-icon
        #navbarSupportedContent.collapse.navbar-collapse
          ul.navbar-nav.me-auto.mb-2.mb-lg-0
            li.nav-item
              a.nav-link(href='index.html') Catálogo
            li.nav-item
              a.nav-link(href='?carrito=1') Carrito
          span.navbar-text
            | Productos en carrito:
            span#cart-count.badge.bg-dark.text-white.ms-2 0
    header.bg-dark.py-5
      .container.px-4.px-lg-5.my-3
        .text-center.text-white
          h1.display-5.fw-bolder Servicio técnico Relive
          p.lead.fw-normal.text-white-50.mb-0 Reparación y venta de accesorios para celulares
    main
      section#catalogo.py-5
        .container.px-4.px-lg-5
          .row.align-items-center.mb-4
            .col-lg-8
              h2.h3 Catálogo
              p#catalogo-status.text-muted.mb-0
            .col-lg-4
              input#buscador.form-control(type='search' placeholder='Buscar producto, código o marca…' autocomplete='off')
          #catalogo-filtros.mb-4
            #categorias-nav.d-flex.flex-wrap.gap-2.mb-2
            #subcategorias-nav.d-flex.flex-wrap.gap-2
          #grid-productos.row.gx-4.gx-lg-5.row-cols-1.row-cols-sm-2.row-cols-md-3.row-cols-xl-4.justify-content-center
          #paginacion.d-flex.flex-wrap.justify-content-center.gap-2.mt-4
      section#detalle.py-5(style='display:none')
        .container.px-4.px-lg-5
          a.btn.btn-outline-dark.mb-4(href='index.html') ← Volver al catálogo
          #producto-detalle
      section#carrito-section.py-5(style='display:none')
        .container.px-4.px-lg-5
          h2.h3.mb-4 Carrito
          #carrito
    footer.py-5.bg-dark
      .container
        p.m-0.text-center.text-white © 2026 Relive · Pinamar, Canelones, Uruguay
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
    script(src='js/catalog.js')
    script(src='js/cart.js')
    script(src='js/app.js')
    script(src='js/product.js')
    script(src='js/cart-page.js')
    script.
      document.addEventListener('DOMContentLoaded', () => {
        const p = new URLSearchParams(location.search);
        const product = p.get('producto');
        const cart = p.get('carrito');
        document.getElementById('catalogo').style.display = product || cart ? 'none' : '';
        document.getElementById('detalle').style.display = product ? '' : 'none';
        document.getElementById('carrito-section').style.display = cart ? '' : 'none';
      });

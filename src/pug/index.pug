doctype html
html(lang='es')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description', content='Relive — catálogo de accesorios, informática y servicio técnico.')
    title Relive — Catálogo
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='css/styles.css', rel='stylesheet')
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.relive-header
      .container
        a.navbar-brand.relive-brand.fw-bold(href='index.html' aria-label='Relive, inicio')
          img.relive-logo(src='assets/logo.webp' alt='Relive')
          span.visually-hidden RELIVE
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#nav')
          span.navbar-toggler-icon
        #nav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            li.nav-item: a.nav-item-link.nav-link(href='tienda.html') Tienda
          form#header-search.header-search(role='search')
            label.visually-hidden(for='buscador') Buscar productos
            .search-field
              .input-group
                input#buscador.form-control(type='search', placeholder='¿Qué estás buscando?', autocomplete='off', role='combobox', aria-autocomplete='list', aria-controls='sugerencias-busqueda', aria-expanded='false')
                button#buscar-btn.btn(type='button' aria-label='Buscar') Buscar
              #sugerencias-busqueda.search-suggestions(role='listbox' hidden)
          .relive-header-actions
            a.nav-link.text-white.relive-cart-link(href='cart.html' aria-label='Ver carrito' title='Ver carrito')
              svg.relive-cart-icon(viewBox='0 0 24 24' aria-hidden='true' focusable='false')
                path(d='M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6')
                circle(cx='10' cy='20' r='1.3')
                circle(cx='18' cy='20' r='1.3')
              span.relive-cart-count 0
            .dropdown.user-menu
              button#user-menu-button.btn.user-menu-trigger.dropdown-toggle(type='button' data-bs-toggle='dropdown' aria-expanded='false')
                span.user-menu-icon(aria-hidden='true') ◯
                span Mi cuenta
              ul.dropdown-menu.dropdown-menu-end(aria-labelledby='user-menu-button')
                li: h6.dropdown-header Acceso de usuarios
                li: button.dropdown-item(type='button' data-bs-toggle='modal' data-bs-target='#account-modal' data-account-view='login') Iniciar sesión
                li: button.dropdown-item(type='button' data-bs-toggle='modal' data-bs-target='#account-modal' data-account-view='register') Registrarme
                li: button.dropdown-item(type='button' data-account-signout) Cerrar sesión
      .header-category-bar
        .container
          a(href='#home-categorias') Categorías
          a(href='#ofertas-panel') Ofertas
          a(href='#destacados') Destacados
          a(href='#novedades') Novedades
          a(href='#reparaciones') Reparaciones
          a(href='#resenas') Reseñas
    main#inicio
      section.relive-hero
        .container
          .relive-hero-content
            span.eyebrow Tecnología que vuelve a funcionar
            h1 Electrónica, informática y reparación con respaldo real.
            p Encontrá accesorios, equipos y soluciones para que tu tecnología siga dando más.
            .d-flex.flex-wrap.gap-3
              a.btn.btn-light.btn-lg(href='tienda.html') Ver tienda
              a.btn.btn-outline-light.btn-lg(href='#reparaciones') Reparaciones
          .relive-hero-mark(aria-hidden='true') R
      section#home-categorias.home-section.container(aria-labelledby='categorias-titulo')
        .section-heading
          div
            span.eyebrow.text-fire Elegí por categoría
            h2#categorias-titulo Encontrá lo que necesitás
          a.section-link(href='tienda.html') Ver catálogo →
        #home-categorias-grid.category-grid
      section#ofertas-panel.offer-panel.container-fluid(aria-labelledby='ofertas-titulo')
        .offer-panel-content.container
          .section-heading.light-heading
            div
              span.offer-kicker Promos Relive
              h2#ofertas-titulo Ofertas que valen la pena
              p#ofertas-info.mb-0 Buscando promociones disponibles…
            a.btn.btn-light(href='tienda.html') Ver todas
          .offer-carousel.mt-4
            #ofertas-productos.offer-products.row.g-3
            .d-flex.justify-content-between.align-items-center.mt-3
              button#ofertas-anterior.btn.btn-sm.btn-outline-light(type='button' aria-label='Oferta anterior') ←
              #ofertas-paginacion.offer-pagination.d-flex.gap-2(aria-label='Paginación de ofertas')
              button#ofertas-siguiente.btn.btn-sm.btn-outline-light(type='button' aria-label='Oferta siguiente') →
          #ofertas-marcas.offer-brands.d-flex.flex-wrap.gap-2.mt-3
      section#destacados.home-section.container(aria-labelledby='destacados-titulo')
        .section-heading
          div
            span.eyebrow.text-fire Selección Relive
            h2#destacados-titulo Productos destacados
          a.section-link(href='tienda.html') Ver tienda →
        #destacados-productos.product-showcase.row.g-4
      section#novedades.home-section.home-section-tint(aria-labelledby='novedades-titulo')
        .container
          .section-heading
            div
              span.eyebrow.text-fire Lo último del catálogo
              h2#novedades-titulo Novedades
            a.section-link(href='tienda.html') Explorar todo →
          #novedades-productos.product-showcase.row.g-4
      section#reparaciones.repairs-band
        .container
          .repairs-content
            span.eyebrow Reparaciones y mantenimiento
            h2 Tu equipo merece una segunda oportunidad.
            p Diagnóstico, mantenimiento y reparación de consolas y electrónica con atención cercana.
            a.btn.btn-light(href='mailto:contacto@relive.com.uy') Consultar reparación
          .repairs-icon(aria-hidden='true') +
      section#resenas.home-section.reviews-section(aria-labelledby='resenas-titulo')
        .container
          .reviews-layout
            .reviews-copy
              span.eyebrow.text-fire Estamos en Pinamar
              h2#resenas-titulo Tu experiencia también cuenta.
              p Las opiniones de Relive se publican en Google. Consultalas o compartí la tuya desde nuestra ficha.
              .reviews-actions
                a.btn.btn-dark(href='https://maps.app.goo.gl/kTgSwGDXsE5u5jeg9' target='_blank' rel='noopener noreferrer') Ver opiniones en Google
                a.reviews-write-link(href='https://maps.app.goo.gl/kTgSwGDXsE5u5jeg9' target='_blank' rel='noopener noreferrer') Dejar una reseña →
              p.reviews-note Las reseñas de Google no se sincronizan automáticamente con esta web.
            .reviews-map
              iframe(title='Ubicación de Relive en Google Maps' data-map-src='https://www.google.com/maps?q=Relive%20Servicio%20t%C3%A9cnico%20de%20celulares%2C%20Pinamar%2C%20Canelones&output=embed' loading='lazy' referrerpolicy='no-referrer-when-downgrade')
              a.reviews-map-link(href='https://maps.app.goo.gl/kTgSwGDXsE5u5jeg9' target='_blank' rel='noopener noreferrer') Abrir ubicación en Google Maps ↗
    footer.bg-dark.text-white.relive-footer
      .container
        .footer-grid
          div
            img.relive-logo(src='assets/logo.webp' alt='Relive')
            p.mt-3.mb-0 Tecnología, accesorios y reparación.
          div
            h3 Tienda
            a(href='tienda.html') Todos los productos
            a(href='#ofertas-panel') Ofertas
            a(href='#destacados') Destacados
          div
            h3 Ayuda
            a(href='#home-categorias') Categorías
            a(href='#reparaciones') Reparaciones
            a(href='#resenas') Ubicación y reseñas
            a(href='cart.html') Carrito
        p.footer-legal © 2026 Relive · Pinamar, Canelones, Uruguay
    #account-modal.modal.fade(tabindex='-1' aria-labelledby='account-modal-title' aria-hidden='true')
      .modal-dialog.modal-dialog-centered
        .modal-content.account-modal-content
          .modal-header
            h2#account-modal-title.modal-title Mi cuenta
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Cerrar')
          .modal-body
            .account-feedback.alert.alert-info(hidden)
            .account-view#account-login
              span.eyebrow.text-fire Acceso de usuarios
              h3 Iniciar sesión
              p.text-muted Ingresá a tu cuenta Relive.
              form
                label.form-label(for='login-email') Email
                input#login-email.form-control(type='email' autocomplete='email' required)
                label.form-label.mt-3(for='login-password') Contraseña
                input#login-password.form-control(type='password' autocomplete='current-password' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Iniciar sesión
              button.account-switch(type='button' data-account-switch='recovery') Olvidé mi contraseña
              button.account-switch(type='button' data-account-switch='register') ¿Todavía no tenés cuenta? Registrate
            .account-view#account-register(hidden)
              span.eyebrow.text-fire Crear cuenta
              h3 Registrarme en Relive
              p.text-muted Guardá tus datos para futuras compras.
              form
                label.form-label(for='register-name') Nombre
                input#register-name.form-control(type='text' autocomplete='name' required)
                label.form-label.mt-3(for='register-email') Email
                input#register-email.form-control(type='email' autocomplete='email' required)
                label.form-label.mt-3(for='register-password') Contraseña
                input#register-password.form-control(type='password' autocomplete='new-password' minlength='8' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Crear cuenta
              button.account-switch(type='button' data-account-switch='login') Ya tengo una cuenta
            .account-view#account-recovery(hidden)
              span.eyebrow.text-fire Recuperar acceso
              h3 Restablecer contraseña
              p.text-muted Te enviaremos un enlace para crear una nueva contraseña.
              form
                label.form-label(for='recovery-email') Email
                input#recovery-email.form-control(type='email' autocomplete='email' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Enviar enlace
              button.account-switch(type='button' data-account-switch='login') Volver a iniciar sesión
            .account-view#account-password-update(hidden)
              span.eyebrow.text-fire Actualizar acceso
              h3 Elegí una nueva contraseña
              form
                label.form-label(for='new-password') Nueva contraseña
                input#new-password.form-control(type='password' autocomplete='new-password' minlength='8' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Guardar contraseña
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
    script(src='https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2')
    script(src='js/supabase-config.js')
    script(src='js/scripts.js')
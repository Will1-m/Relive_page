doctype html
html(lang='es')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    meta(name='description', content='Relive — tienda online de accesorios, informática y electrónica.')
    title Relive — Tienda
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='css/styles.css', rel='stylesheet')
  body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.relive-header
      .container
        a.navbar-brand.relive-brand.fw-bold(href='index.html' aria-label='Relive, inicio')
          img.relive-logo(src='assets/logo.webp' alt='Relive')
          span.visually-hidden RELIVE
        button.navbar-toggler(type='button' data-bs-toggle='collapse' data-bs-target='#nav-tienda' aria-label='Abrir navegación')
          span.navbar-toggler-icon
        #nav-tienda.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            li.nav-item: a.nav-link(href='index.html') Inicio
            li.nav-item: a.nav-link.active(href='tienda.html' aria-current='page') Tienda
          form#header-search.header-search(role='search')
            label.visually-hidden(for='buscador') Buscar productos
            .search-field
              .input-group
                input#buscador.form-control(type='search' placeholder='¿Qué estás buscando?' autocomplete='off' role='combobox' aria-autocomplete='list' aria-controls='sugerencias-busqueda' aria-expanded='false')
                button#buscar-btn.btn(type='button' aria-label='Buscar') Buscar
              #sugerencias-busqueda.search-suggestions(role='listbox' hidden)
          .relive-header-actions
            a.nav-link.text-white.relive-cart-link(href='cart.html' aria-label='Ver carrito' title='Ver carrito')
              svg.relive-cart-icon(viewBox='0 0 24 24' aria-hidden='true' focusable='false')
                path(d='M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 8H6')
                circle(cx='10' cy='20' r='1.3')
                circle(cx='18' cy='20' r='1.3')
              span.relive-cart-count 0
            .dropdown.user-menu
              button#user-menu-button.btn.user-menu-trigger.dropdown-toggle(type='button' data-bs-toggle='dropdown' aria-expanded='false')
                span.user-menu-icon(aria-hidden='true') ◯
                span Mi cuenta
              ul.dropdown-menu.dropdown-menu-end(aria-labelledby='user-menu-button')
                li: h6.dropdown-header Acceso de usuarios
                li: button.dropdown-item(type='button' data-bs-toggle='modal' data-bs-target='#account-modal' data-account-view='login') Iniciar sesión
                li: button.dropdown-item(type='button' data-bs-toggle='modal' data-bs-target='#account-modal' data-account-view='register') Registrarme
      .header-category-bar
        .container
          a(href='#categorias-nav') Categorías
          a(href='#ofertas-panel') Ofertas
          a(href='#grid-productos') Productos
          a(href='index.html#reparaciones') Reparaciones
    main.catalog-page
      section#ofertas-panel.offer-panel.container-fluid(aria-labelledby='ofertas-titulo')
        .offer-panel-content.container
          .section-heading.light-heading
            div
              span.offer-kicker Promos Relive
              h1#ofertas-titulo Ofertas
              p#ofertas-info.mb-0 Buscando promociones disponibles…
          .offer-carousel.mt-4
            #ofertas-productos.offer-products.row.g-3
            .d-flex.justify-content-between.align-items-center.mt-3
              button#ofertas-anterior.btn.btn-sm.btn-outline-light(type='button' aria-label='Oferta anterior') ←
              #ofertas-paginacion.offer-pagination.d-flex.gap-2(aria-label='Paginación de ofertas')
              button#ofertas-siguiente.btn.btn-sm.btn-outline-light(type='button' aria-label='Oferta siguiente') →
          #ofertas-marcas.offer-brands.d-flex.flex-wrap.gap-2.mt-3
      section#catalogo-view.catalog-section.container.py-5(aria-labelledby='catalogo-titulo')
        .catalog-heading
          div
            span.eyebrow.text-fire Catálogo completo
            h2#catalogo-titulo Tienda Relive
          a.btn.btn-outline-dark(href='index.html') Volver al inicio
        .row.g-3.mb-4
          .col-sm-6.col-lg-3
            label.form-label(for='filtro-marca') Marca
            select#filtro-marca.form-select: option(value='') Todas
          .col-sm-6.col-lg-3
            label.form-label(for='orden') Ordenar
            select#orden.form-select
              option(value='relevancia') Relevancia
              option(value='precio-asc') Precio menor
              option(value='precio-desc') Precio mayor
              option(value='nombre') Nombre
          .col-sm-6.col-lg-3.d-flex.align-items-end
            a.btn.btn-outline-dark.w-100(href='cart.html') Ver carrito
        #categorias-nav.d-flex.flex-wrap.gap-2.mb-3
        #subcategorias-nav.d-flex.flex-wrap.gap-2.mb-4
        .d-flex.justify-content-between.align-items-center.mb-3
          p#resultado-info.text-muted.mb-0 Cargando catálogo…
          select#por-pagina.form-select.form-select-sm(style='width:auto')
            option(value='24') 24 por página
            option(value='48') 48 por página
            option(value='96') 96 por página
        #grid-productos.row.g-4
        nav.mt-4(aria-label='Paginación'): ul#paginacion.pagination.justify-content-center.flex-wrap
    footer.bg-dark.text-white.relive-footer
      .container
        .footer-grid
          div
            img.relive-logo(src='assets/logo.webp' alt='Relive')
            p.mt-3.mb-0 Tecnología, accesorios y reparación.
          div
            h3 Tienda
            a(href='tienda.html') Todos los productos
            a(href='#ofertas-panel') Ofertas
            a(href='index.html#destacados') Destacados
          div
            h3 Ayuda
            a(href='#categorias-nav') Categorías
            a(href='index.html#reparaciones') Reparaciones
            a(href='cart.html') Carrito
        p.footer-legal © 2026 Relive · Pinamar, Canelones, Uruguay
    #account-modal.modal.fade(tabindex='-1' aria-labelledby='account-modal-title' aria-hidden='true')
      .modal-dialog.modal-dialog-centered
        .modal-content.account-modal-content
          .modal-header
            h2#account-modal-title.modal-title Mi cuenta
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Cerrar')
          .modal-body
            .account-feedback.alert.alert-info(hidden)
            .account-view#account-login
              span.eyebrow.text-fire Acceso de usuarios
              h3 Iniciar sesión
              p.text-muted Ingresá a tu cuenta Relive.
              form
                label.form-label(for='login-email') Email
                input#login-email.form-control(type='email' autocomplete='email' required)
                label.form-label.mt-3(for='login-password') Contraseña
                input#login-password.form-control(type='password' autocomplete='current-password' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Iniciar sesión
              button.account-switch(type='button' data-account-switch='register') ¿Todavía no tenés cuenta? Registrate
            .account-view#account-register(hidden)
              span.eyebrow.text-fire Crear cuenta
              h3 Registrarme en Relive
              p.text-muted Guardá tus datos para futuras compras.
              form
                label.form-label(for='register-name') Nombre
                input#register-name.form-control(type='text' autocomplete='name' required)
                label.form-label.mt-3(for='register-email') Email
                input#register-email.form-control(type='email' autocomplete='email' required)
                label.form-label.mt-3(for='register-password') Contraseña
                input#register-password.form-control(type='password' autocomplete='new-password' required)
                button.btn.btn-dark.w-100.mt-4(type='submit') Crear cuenta
              button.account-switch(type='button' data-account-switch='login') Ya tengo una cuenta
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js')
    script(src='js/scripts.js')
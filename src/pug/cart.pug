doctype html
html(lang='es')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title Relive — Carrito
    link(rel='icon', type='image/x-icon', href='assets/favicon.ico')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='css/styles.css', rel='stylesheet')
  body
    nav.navbar.navbar-dark.bg-dark
      .container
        a.navbar-brand.relive-brand.fw-bold(href='index.html' aria-label='Relive, inicio')
          img.relive-logo(src='assets/logo.webp' alt='Relive')
          span.visually-hidden RELIVE
        .d-flex.align-items-center.gap-3
          a.nav-link.text-white(href='index.html') Catálogo
          span.navbar-text.text-white Artículos: <span class='relive-cart-count'>0</span>
    main.container.py-5
      h1.mb-4 Tu carrito
      #carrito
    script(src='js/scripts.js')